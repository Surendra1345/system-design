# Copy to backend/.env and edit. Every value is optional.

# SQLite by default. For PostgreSQL use, for example:
# DATABASE_URL=postgresql://blueprint:blueprint@localhost:5432/blueprint
DATABASE_URL=sqlite:///./data/blueprint.db

# Turns on the AI tutor, AI interviewer, design reviewer and planner.
# Without a key the app still works and falls back to simple rules.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Browser origins allowed to call the API during development
CORS_ORIGINS=http://localhost:5173
